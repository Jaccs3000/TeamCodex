    "start": "node server.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0"
  }
}
