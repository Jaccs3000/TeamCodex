{
  "name": "ai-dev-studio",
  "version": "1.0.0",
  "private": true,
  "description": "AI Dev Studio local para Windows",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"node --watch server.mjs\" \"vite --host 127.0.0.1\"",
